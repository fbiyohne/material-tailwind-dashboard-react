# Connexion PostgreSQL (V2)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/barreau_pn?schema=public"
# Secret de signature des JWT (à changer en production)
JWT_SECRET="change-me"
PORT=4000
# Origine autorisée pour le CORS (front)
CLIENT_ORIGIN="http://localhost:5173"
# Chemin du binaire Chromium pour la génération PDF serveur (Puppeteer)
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
# Email (laisser vide → mode simulation qui journalise les envois)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="secretariat@barreau-pn.cg"
# Signature qualifiée : fournir une clé RSA (PEM) ou laisser vide (générée en dev)
SIGNATURE_PRIVATE_KEY=""
SIGNATURE_PUBLIC_KEY=""
SIGNATURE_KEY_DIR="secrets"
# Ancienne clé de signature (rotation) : conservée uniquement pour vérifier les jetons QR antérieurs.
# Une seule ancienne clé est acceptée : une 2e rotation invalide les QR de la 1re génération (README, « Rotation des secrets »).
SIGNATURE_ANCIENNE_PRIVATE_KEY=""
# Bascule des anciens QR /verifier/... (sans code) : seuls les documents créés avant cette date restent vérifiables par cette voie.
# À fixer à la date de mise en service de la page /v (T10).
VERIF_BASCULE="2026-10-12"
# Ne plus modifier après la mise en service.
# Clé de chiffrement (AES-256-GCM) des secrets saisis dans Paramètres : mot de passe SMTP,
# clés des passerelles de paiement et du fournisseur SMS. 32 octets en base64, générés par :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Vide → aucun secret enregistrable (400). La perdre rend illisibles les secrets déjà chiffrés.
PARAMS_CLE=""
# IA — génération des projets d'article de la Lettre du Bâtonnier (Claude)
# Laisser vide → repli automatique sur un gabarit local (mode simulation)
ANTHROPIC_API_KEY=""
# Journalisation structurée (pino) : niveau et format
LOG_LEVEL="info"
# LOG_JSON=1 force la sortie JSON même en développement (sinon pino-pretty)
LOG_JSON=""
# Base de test (suite vitest) — 127.0.0.1 et non localhost : sur Windows, localhost peut
# résoudre en IPv6 ([::1]) vers un relais WSL au lieu du socle Docker (P1001).
TEST_DATABASE_URL="postgresql://barreau:barreau_dev@127.0.0.1:5432/barreau_pn_test?schema=public"
# Nombre de relais de confiance pour lire X-Forwarded-For (IP dans JournalAudit).
# Défaut 1 (un mandataire). Passer à 0 en exposition directe.
TRUST_PROXY=1
# Adresse d'écoute de l'API (défaut 0.0.0.0 = tous réseaux). En test/démo : 127.0.0.1
HOST=0.0.0.0
# Environnement Node.js : défini à 'test' par vitest, 'production' en déploiement, 'development' sinon
NODE_ENV=""
# TLS implicite du SMTP d'environnement (true pour le port 465)
SMTP_SECURE=""
# URL SMTP : lue seulement par l'avertissement de démarrage ; laisser vide
SMTP_URL=""
# Paiement : vide = bac à sable. Aucun adaptateur réel : ne pas renseigner sans validation
PAYMENT_PROVIDER=""
# Secret des webhooks de paiement (requis si PAYMENT_PROVIDER est défini)
PAYMENT_WEBHOOK_SECRET=""
# Passerelle SMS HTTP générique (vide = simulation)
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="Barreau-PN"
# Assistant d'installation : 1 tant qu'aucun ADMIN n'existe, puis retirer
INSTALL_WIZARD=""
# Dossier du front construit servi par l'API (vide = non servi)
STATIC_DIR=""
# Stockage des pièces et archives (défaut ./uploads) ; volume persistant en production
STORAGE_DIR=""
