// Schéma de données — Secrétariat Général du Barreau de Pointe-Noire (V2)
// PostgreSQL + Prisma. Modélise les entités principales du PRD (§6.2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SECRETAIRE_GENERAL
  BATONNIER
  TRESORIERE
  ADMIN
}

enum Qualite {
  AVOCAT
  STAGIAIRE
  HONORAIRE
}

enum StatutMembre {
  INSCRIT
  SUSPENDU
  RADIE
  OMIS
  HONORAIRE
  STAGIAIRE
}

enum TypeAssemblee {
  AGO
  AGE
}

enum StatutDossier {
  OUVERT
  INSTRUCTION
  AUDIENCE
  DECISION
  CLASSE
}

enum StatutPublication {
  BROUILLON
  A_VALIDER
  VALIDE
  PUBLIE
}

model User {
  id            Int            @id @default(autoincrement())
  nom           String
  email         String         @unique
  role          Role
  passwordHash  String
  actif         Boolean        @default(true)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Membre {
  id              Int          @id @default(autoincrement())
  num             Int          @unique
  numInscription  String?      @unique
  nom             String
  qualite         Qualite
  statut          StatutMembre @default(INSCRIT)
  cabinet         String?
  tel             String?
  email           String?
  rccm            String?
  cnss            String?
  adresse         String?
  dateNaissance   DateTime?
  dateInscription DateTime?
  observations    String?
  // Stage (avocats stagiaires)
  dateServment    DateTime?
  dureeMois       Int?
  maitreStage     String?

  cotisations Cotisation[]
  recus       Recu[]
  quitus      Quitus[]
  droitsPlaidoirie DroitPlaidoirie[]
  dossiers    DossierDisciplinaire[]
  pieces      PieceDossier[]
  paiements   Paiement[]
  createdAt   DateTime               @default(now())
}

enum StatutPaiement {
  INITIE
  EN_ATTENTE
  REUSSI
  ECHEC
}

/// Paiement en ligne (passerelle) — cotisation ou droit de plaidoirie.
/// À la réussite, alimente le flux d'encaissement (reçu + situation, BR-03).
model Paiement {
  id         Int            @id @default(autoincrement())
  ref        String         @unique
  canal      String // MTN, AIRTEL, CARTE, VIREMENT, SANDBOX
  type       String // cotisation, droit
  membre     Membre         @relation(fields: [membreId], references: [id])
  membreId   Int
  annee      Int
  montant    Int
  statut     StatutPaiement @default(INITIE)
  recuNumero String? // reçu émis à la réussite (garantit l'idempotence)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([membreId])
}

enum StatutPiece {
  A_VERIFIER
  VERIFIEE
  REJETEE
}

/// Journal des notifications émises (email / SMS) — traçabilité des envois.
model JournalNotification {
  id           Int      @id @default(autoincrement())
  canal        String // EMAIL, SMS
  destinataire String
  sujet        String
  evenement    String // RELANCE, DEMANDE_ACCUSE, DEMANDE_DECISION, RECU, …
  statut       String // ENVOYE, ECHEC
  simulation   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Pièce du dossier d'inscription (vérification documentaire — KYC proportionné).
/// Accès cloisonné (données personnelles) ; vérification par le SG/Admin.
model PieceDossier {
  id          Int         @id @default(autoincrement())
  membre      Membre      @relation(fields: [membreId], references: [id], onDelete: Cascade)
  membreId    Int
  type        String // IDENTITE, DIPLOME, SERMENT, PHOTO, CASIER, AUTRE
  nomFichier  String
  fichier     String // chemin de stockage relatif (StorageProvider)
  mimeType    String
  taille      Int
  statut      StatutPiece @default(A_VERIFIER)
  note        String?
  verifieePar String?
  verifieeAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([membreId])
}

model DroitPlaidoirie {
  id           Int       @id @default(autoincrement())
  membre       Membre    @relation(fields: [membreId], references: [id], onDelete: Cascade)
  membreId     Int
  annee        Int
  montantDu    Int
  montantPaye  Int       @default(0)
  datePaiement DateTime?
  mode         String?
  ref          String?

  @@unique([membreId, annee])
  @@index([annee])
}

model Cotisation {
  id               Int       @id @default(autoincrement())
  membre           Membre    @relation(fields: [membreId], references: [id], onDelete: Cascade)
  membreId         Int
  annee            Int
  montantDu        Int
  montantPaye      Int       @default(0)
  datePaiement     DateTime?
  mode             String?
  ref              String?
  valideTresoriere Boolean   @default(false)

  @@unique([membreId, annee])
  @@index([annee])
}

model Recu {
  id        Int      @id @default(autoincrement())
  numero    String   @unique
  membre    Membre   @relation(fields: [membreId], references: [id])
  membreId  Int
  montant   Int
  annee     Int
  date      DateTime
  mode      String?
  ref       String?
  objet     String?
  createdAt DateTime @default(now())
}

model Quitus {
  id           Int      @id @default(autoincrement())
  numero       String   @unique
  membre       Membre   @relation(fields: [membreId], references: [id])
  membreId     Int
  annee        Int
  dateEmission DateTime
  createdAt    DateTime @default(now())
}

model DossierDisciplinaire {
  id              Int           @id @default(autoincrement())
  reference       String        @unique
  membre          Membre?       @relation(fields: [membreId], references: [id])
  membreId        Int?
  avocatNom       String
  objet           String
  dateSaisine     DateTime
  dateConvocation DateTime?
  dateAudience    DateTime?
  decision        String?
  sanction        String?
  pieces          String[]      @default([])
  statut          StatutDossier @default(OUVERT)
  createdAt       DateTime      @default(now())
}

model Reunion {
  id          Int      @id @default(autoincrement())
  date        DateTime
  heure       String?
  lieu        String?
  ordreDuJour String[]
  statut      String   @default("planifiee")
  pv          String?
  presences   Json?
}

model Assemblee {
  id            Int           @id @default(autoincrement())
  type          TypeAssemblee
  date          DateTime
  lieu          String?
  ordreDuJour   String[]
  quorumPresent Int           @default(0)
  statut        String        @default("convoquee")
  decisions     String[]
  pv            String?
}

model Archive {
  id        Int       @id @default(autoincrement())
  categorie String
  titre     String
  reference String?
  date      DateTime?
  membreNom String?
  archiveLe DateTime  @default(now())
}

model Publication {
  id      Int               @id @default(autoincrement())
  titre   String
  type    String
  contenu String?
  statut  StatutPublication @default(A_VALIDER)
  date    DateTime          @default(now())
}

model JournalDiscipline {
  id     Int      @id @default(autoincrement())
  action String
  quand  DateTime @default(now())
  userId Int?
}

/// Journal d'audit transverse — historise les actions importantes (RG-16 / NFR-09).
model JournalAudit {
  id      Int      @id @default(autoincrement())
  action  String
  cible   String?
  methode String
  chemin  String
  statut  Int
  userId  Int?
  userNom String?
  quand   DateTime @default(now())

  @@index([quand])
}

model Parametres {
  id   Int  @id @default(1)
  data Json
}

/// Composition du Conseil de l'Ordre — alimente les feuilles de présence des réunions (FR-REU).
model MembreConseil {
  id       Int     @id @default(autoincrement())
  nom      String
  fonction String
  ordre    Int     @default(0)
  actif    Boolean @default(true)
}

/// Calendrier éditorial mensuel de la Lettre du Bâtonnier (FR-BAT).
model CalendrierEditorial {
  id     Int    @id @default(autoincrement())
  mois   String @unique
  theme  String
  statut String @default("a_rediger")
  ordre  Int    @default(0)
}

enum StatutDemande {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

/// Demande d'accès soumise publiquement (page « Demander un accès »).
/// Ne crée aucun compte : la demande est mise en file d'attente puis validée
/// par le SG/Admin, qui provisionne le compte (cloisonnement RBAC).
model DemandeAcces {
  id             Int           @id @default(autoincrement())
  nom            String
  email          String
  numInscription String?
  cabinet        String?
  motif          String
  statut         StatutDemande @default(EN_ATTENTE)
  createdAt      DateTime      @default(now())
  traiteeAt      DateTime?
}
